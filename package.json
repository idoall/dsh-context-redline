{
  "name": "dsh-context-redline",
  "version": "0.1.0",
  "description": "上下文批改 (Context Redline) — review, edit, or delete the context a model will receive; open a zero-history ordinary session with the confirmed content; and return its bound result verbatim to the source session. Independent fork of dsh-context (Apache-2.0 portions; provenance in UPSTREAM.md).",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idoall/dsh-context-redline.git"
  },
  "bugs": {
    "url": "https://github.com/idoall/dsh-context-redline/issues"
  },
  "homepage": "https://github.com/idoall/dsh-context-redline#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.2 <0.3.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/client.js",
    "lib/client.js.map",
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-Apache-2.0",
    "NOTICE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm run build",
    "pack:check": "pnpm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "namespace-contract": "node scripts/namespace-contract.mjs",
    "test": "vitest run --project edit --project channel --project client-logic --project client-ui",
    "test:upstream": "vitest run --project host --project client",
    "verify": "pnpm run typecheck && pnpm run lint && node scripts/check-docs.mjs && pnpm run namespace-contract && node scripts/css-closure.mjs && node scripts/i18n-orphans.mjs && pnpm run build && pnpm run test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "context",
    "redline",
    "edit",
    "ui"
  ],
  "license": "MIT AND Apache-2.0",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@opencode-ai/models": "^0.0.93",
    "@shikijs/langs": "^4.3.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.1.0",
    "diff": "^9.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "immer": "^10.0.0",
    "jsdom": "^30.1.1",
    "katex": "^0.16.47",
    "lightningcss": "1.32.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.3.1",
    "simple-icons": "16.32.0",
    "tailwindcss": "4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zustand": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.1"
}
